# Example secrets for the UNODE POC. Copy to secrets.yaml and fill in real values.
# secrets.yaml is git-ignored: never commit it.
wifi_ssid: "YOUR_TRAILER_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
fallback_password: "make-up-8-plus-chars"
ota_password: "make-up-another-password"
mqtt_broker: "192.168.1.X"   # IP address of the Raspberry Pi running Home Assistant
mqtt_user: "unode"
mqtt_password: "PASSWORD_OF_THE_HA_USER_YOU_CREATE_IN_STEP_1"
